#!/bin/bash
# EC2の初回起動時に1回だけ実行されるセットアップ（Terraform の templatefile で値を埋め込む）。
# Docker・nginx・アプリ用の docker-compose.yml までを用意する。
# アプリ本体（app.jar とフロントエンドのファイル）は後でデプロイする。
#   80番   → nginx: /opt/task-manager/frontend を配信し、/api/ をバックエンドへ中継
#   8080番 → Spring Boot（app.jar）。DBは RDS を使う
# ※ 波かっこ付きの変数（docker compose 用）は、ドル記号を2つ重ねて書く（Terraform を通ると1つになる）
set -euxo pipefail

# Elastic IP の付け替え直後などで通信が一瞬切れても、失敗せずにやり直す
retry() {
  for i in 1 2 3 4 5; do
    "$@" && return 0
    sleep 10
  done
  return 1
}

# メモリ1GBでも Spring Boot が落ちないよう、2GBのスワップを作る
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

retry dnf install -y docker
systemctl enable --now docker

# Amazon Linux 2023 の docker パッケージには compose が入っていないので追加する
mkdir -p /usr/local/lib/docker/cli-plugins
retry curl -fsSL "https://github.com/docker/compose/releases/latest/download/docker-compose-linux-$(uname -m)" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

APP_DIR=/opt/task-manager
mkdir -p "$APP_DIR/frontend" "$APP_DIR/nginx"
cd "$APP_DIR"

# DBのパスワードは Parameter Store から読み、このサーバーの root だけが読めるファイルに置く
# （パスワードが起動ログに出ないよう、この間はコマンドの表示を止める）
set +x
DB_PASSWORD=$(retry aws ssm get-parameter --region "${region}" --name "${db_password_parameter}" \
  --with-decryption --query Parameter.Value --output text)
umask 077
cat > .env <<EOF
DB_PASSWORD=$DB_PASSWORD
EOF
umask 022
unset DB_PASSWORD
set -x

# フロントエンドをデプロイするまでの仮のページ
if [ ! -f frontend/index.html ]; then
  cat > frontend/index.html <<'EOF'
<!doctype html>
<html lang="ja"><meta charset="utf-8"><title>準備中</title>
<p>タスク管理アプリは準備中です。</p>
</html>
EOF
fi

cat > nginx/default.conf <<'EOF'
server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;
  # ボードのインポート（JSON）を送れるようにする
  client_max_body_size 10m;

  location / {
    try_files $uri $uri/ /index.html;
  }

  # API はバックエンドへ中継する。宛先を変数にして、バックエンドが止まっていても nginx は起動できるようにする
  location /api/ {
    resolver 127.0.0.11 valid=10s;
    set $backend http://app:8080;
    proxy_pass $backend;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
EOF

cat > docker-compose.yml <<'EOF'
services:
  # フロントエンド（index.html / style.css / app.js）を frontend/ に置くと、80番で配信される
  web:
    image: nginx:alpine
    restart: unless-stopped
    volumes:
      - ./frontend:/usr/share/nginx/html:ro
      - ./nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
    ports:
      - "80:80"
    mem_limit: 64m

  # app.jar を /opt/task-manager に置いてから `docker compose up -d app` で起動する
  app:
    image: eclipse-temurin:25-jre
    restart: unless-stopped
    environment:
      SPRING_DATASOURCE_URL: jdbc:postgresql://${db_host}:5432/${db_name}
      SPRING_DATASOURCE_USERNAME: ${db_username}
      SPRING_DATASOURCE_PASSWORD: $${DB_PASSWORD}
    volumes:
      - ./app.jar:/app/app.jar:ro
    command: ["java", "-Xmx384m", "-Xss512k", "-XX:MaxMetaspaceSize=128m", "-jar", "/app/app.jar"]
    ports:
      - "8080:8080"
    mem_limit: 640m
EOF

retry docker compose up -d web

# アプリより先にイメージを取っておく（デプロイ時にすぐ起動できるように）
retry docker pull eclipse-temurin:25-jre
