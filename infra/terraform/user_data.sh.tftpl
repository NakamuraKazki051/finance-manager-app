#!/bin/bash
# EC2の初回起動時に1回だけ実行されるセットアップ（Terraform の templatefile で値を埋め込む）。
# Docker・nginx・アプリ用の docker-compose.yml までを用意する。
# アプリ本体（Rails のイメージと、Next.js で書き出したフロントエンドのファイル）は後で deploy.ps1 が送る。
#   80番   → nginx: /opt/finance-manager/frontend を配信し、/api/ をバックエンドへ中継
#   8080番 → Rails API（コンテナの中は3000番）。DBは RDS for MySQL を使う
# ※ 波かっこ付きの変数（docker compose 用）は、ドル記号を2つ重ねて書く（Terraform を通ると1つになる）
set -euxo pipefail

# Elastic IP の付け替え直後などで通信が一瞬切れても、失敗せずにやり直す
retry() {
  for i in 1 2 3 4 5; do
    "$@" && return 0
    sleep 10
  done
  return 1
}

# メモリ1GBでもイメージの読み込みや Rails の起動で落ちないよう、2GBのスワップを作る
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

retry dnf install -y docker
systemctl enable --now docker

# Amazon Linux 2023 の docker パッケージには compose が入っていないので追加する
mkdir -p /usr/local/lib/docker/cli-plugins
retry curl -fsSL "https://github.com/docker/compose/releases/latest/download/docker-compose-linux-$(uname -m)" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

APP_DIR=/opt/finance-manager
mkdir -p "$APP_DIR/frontend" "$APP_DIR/nginx"
cd "$APP_DIR"

# DBのパスワードは Parameter Store から読み、このサーバーの root だけが読めるファイルに置く
# （パスワードが起動ログに出ないよう、この間はコマンドの表示を止める）
set +x
DB_PASSWORD=$(retry aws ssm get-parameter --region "${region}" --name "${db_password_parameter}" \
  --with-decryption --query Parameter.Value --output text)
umask 077
# SECRET_KEY_BASE はログインのCookieの暗号化に使う。サーバーを作るたびに新しく作る（作り直すと全員ログアウトになる）
cat > .env <<EOF
DB_PASSWORD=$DB_PASSWORD
SECRET_KEY_BASE=$(openssl rand -hex 64)
EOF
umask 022
unset DB_PASSWORD
set -x

# フロントエンドをデプロイするまでの仮のページ
if [ ! -f frontend/index.html ]; then
  cat > frontend/index.html <<'EOF'
<!doctype html>
<html lang="ja"><meta charset="utf-8"><title>準備中</title>
<p>収支管理アプリは準備中です。</p>
</html>
EOF
fi

cat > nginx/default.conf <<'EOF'
server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;
  # 家計簿のインポート（JSON）を送れるようにする
  client_max_body_size 10m;

  location / {
    try_files $uri $uri.html $uri/ /index.html;
  }

  # Next.js の書き出したファイルは名前にハッシュが付くので、長くキャッシュしてよい
  location /_next/static/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # API はバックエンドへ中継する。宛先を変数にして、バックエンドが止まっていても nginx は起動できるようにする
  location /api/ {
    resolver 127.0.0.11 valid=10s;
    set $backend http://app:3000;
    proxy_pass $backend;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
EOF

cat > docker-compose.yml <<'EOF'
services:
  # フロントエンド（Next.js の書き出し結果 out/ の中身）を frontend/ に置くと、80番で配信される
  web:
    image: nginx:alpine
    restart: unless-stopped
    volumes:
      - ./frontend:/usr/share/nginx/html:ro
      - ./nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
    ports:
      - "80:80"
    mem_limit: 64m

  # Rails API。deploy.ps1 がイメージ（finance-manager-api:latest）を docker load してから起動する。
  # 起動のたびに未適用のマイグレーションを流す（backend/Dockerfile の CMD）
  app:
    image: finance-manager-api:latest
    restart: unless-stopped
    environment:
      DB_HOST: ${db_host}
      DB_NAME: ${db_name}
      DB_USERNAME: ${db_username}
      DB_PASSWORD: $${DB_PASSWORD}
      SECRET_KEY_BASE: $${SECRET_KEY_BASE}
      # Puma を1プロセス・3スレッドにしてメモリを抑える
      WEB_CONCURRENCY: "0"
      RAILS_MAX_THREADS: "3"
    ports:
      - "8080:3000"
    mem_limit: 512m
EOF

retry docker compose up -d web

# 起動直後に AWS への接続が一度失敗すると、SSM エージェントは休止して長いあいだ再接続しない。
# そうなると deploy.ps1 が送れないので、準備の最後にエージェントを起動し直す
systemctl restart amazon-ssm-agent
